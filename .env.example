GEMINI_API_KEY=

# Model names are config, never code. Check the current list in AI Studio.
# Fast tier: live path (action deltas, rolling summary). No thinking, ~1-2 s.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# Strong tier: end-of-call analysis + QA scoring. The free tier allows only 20 requests/day on
# "flash" models (500/day on "flash-lite"), so the default is flash-lite. With a paid key use a
# thinking model, e.g. gemini-3.5-flash (see the model-size experiment in the README).
GEMINI_MODEL_STRONG=gemini-3.5-flash-lite
# Fallback chain, tried in order. Different models have separate quota and capacity pools.
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite,gemini-3-flash-preview

LLM_MAX_CONCURRENCY=4
# Client-side requests/minute cap per model. The free tier allows ~10 RPM; 0 = off.
LLM_RPM=9

# Local dev (host -> docker port 5434). Inside docker compose these are overridden.
DATABASE_URL=postgresql://convo:convo@localhost:5434/convo
REDIS_URL=redis://localhost:6379/0

# PII backend: regex | gliner | hybrid   (gliner/hybrid need `uv sync --extra ml`)
PII_BACKEND=regex
# Sentiment backend: lexicon | roberta   (roberta needs `uv sync --extra ml`)
SENTIMENT_BACKEND=lexicon
PII_TTL_DAYS=30

# API key for REST (X-API-Key header) and WebSocket (?api_key=). Empty = auth off (local demo only).
API_KEY=
